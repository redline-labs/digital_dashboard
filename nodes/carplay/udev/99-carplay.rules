# Wired CarPlay bring-up: grant the driver raw access to the devices it needs,
# so it does not have to run as root. See docs/carplay_bringup.md.
#
# Install:
#   sudo cp nodes/carplay/udev/99-carplay.rules /etc/udev/rules.d/
#   sudo udevadm control --reload-rules && sudo udevadm trigger
#
# Members of "plugdev" get access; adjust GROUP if your distro differs.

# --- iPhone -----------------------------------------------------------------
# Raw usbfs access to /dev/bus/usb/BBB/DDD for every Apple device. The driver
# drives the phone entirely through usbfs ioctls (control transfers, interface
# claims, bulk IO), so this single rule covers the config switch, the usbmux
# interface, and the NCM interfaces.
#
# ATTR{idVendor} only exists on usb_device nodes, so this matches the device
# and not its interfaces -- which is what usbfs access is keyed on. It re-fires
# on every re-add, so it survives the config switch's re-enumeration.
#
# TAG+="uaccess" additionally grants the user at the active seat, which keeps
# things working across re-enumeration when logged in locally.
SUBSYSTEM=="usb", ATTR{idVendor}=="05ac", MODE="0660", GROUP="plugdev", TAG+="uaccess"

# Keep the desktop's camera monitor off the phone. In the configuration it
# boots into, the phone exposes a PTP still-image interface (class 06/01/01),
# which /lib/udev/rules.d/60-libgphoto2-*.rules matches on to set ID_GPHOTO2=1.
# gvfs-gphoto2-volume-monitor sees that tag, spawns gvfsd-gphoto2, and that
# process claims the interface through usbfs -- at which point our
# USBDEVFS_SETCONFIGURATION returns EBUSY and the switch to configuration 6
# fails. It looks like a permission problem and is not one: running as root
# fails identically, because the interface is claimed, not protected.
#
# libusb's detach-kernel-driver path cannot help here either; the claim comes
# from userspace, not from a kernel driver.
#
# This runs at 99-, after 60-, so clearing the variables wins. Tradeoff: the
# desktop will no longer offer to import photos from an iPhone over USB.
# Delete this rule if you want that back and are willing to stop gvfsd-gphoto2
# by hand before each run.
SUBSYSTEM=="usb", ATTR{idVendor}=="05ac", ENV{ID_GPHOTO2}="", ENV{GPHOTO2_DRIVER}=""

# --- MFi coprocessor, reached over I2C --------------------------------------
# On Linux the MCP2221A is driven by the in-kernel hid_mcp2221 driver, which
# registers it as a standard I2C adapter; we talk to the MFi chip through
# /dev/i2c-N rather than through hidraw. (macOS has no such driver, so it uses
# the userspace hidapi backend instead -- see libs/mfi_i2c.)
#
# Scoped to the bridge's VID/PID via the parent chain so this does not hand out
# every I2C bus on the machine, which on real hardware includes buses that have
# nothing to do with CarPlay.
SUBSYSTEM=="i2c-dev", ATTRS{idVendor}=="04d8", ATTRS{idProduct}=="00dd", \
    MODE="0660", GROUP="plugdev", TAG+="uaccess"
